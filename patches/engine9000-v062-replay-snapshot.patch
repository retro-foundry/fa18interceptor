diff --git a/e9k-debugger/snapshot.c b/e9k-debugger/snapshot.c
index b641e64..c23db35 100644
--- a/e9k-debugger/snapshot.c
+++ b/e9k-debugger/snapshot.c
@@ -16,0 +17 @@
+#include "debug.h"
@@ -20,0 +22,130 @@
+// Legacy captures did not record the restore-hotkey frame.  New captures set
+// E9K_BOOT_RESTORE_FRAME and use the same explicit runtime boundary on replay.
+#define SNAPSHOT_LEGACY_REPLAY_RESTORE_FRAME 37
+
+static int snapshot_replayRestorePending;
+static uint64_t snapshot_replayRestoreFrame;
+static int snapshot_replayFrameDumpConfigured;
+static int snapshot_replayFrameDumped;
+static uint64_t snapshot_replayFrameDumpFrame;
+static char snapshot_replayFrameDumpPath[1024];
+
+static int
+snapshot_configureReplayRestore(void)
+{
+    const char *text = getenv("E9K_BOOT_RESTORE_FRAME");
+    if (text && *text) {
+        char *end = NULL;
+        unsigned long long frame = strtoull(text, &end, 10);
+        if (end && !*end) {
+            snapshot_replayRestoreFrame = (uint64_t)frame;
+            return 1;
+        }
+        debug_error("snapshot: invalid E9K_BOOT_RESTORE_FRAME");
+        return 0;
+    }
+    if (debugger.playbackPath[0]) {
+        snapshot_replayRestoreFrame = SNAPSHOT_LEGACY_REPLAY_RESTORE_FRAME;
+        return 1;
+    }
+    return 0;
+}
+
+static void
+snapshot_writeReplayRestoreMarker(void)
+{
+    const char *path = getenv("E9K_BOOT_RESTORE_MARKER");
+    if (!path || !*path) {
+        return;
+    }
+    FILE *file = fopen(path, "wb");
+    if (!file) {
+        debug_error("snapshot: cannot write boot restore marker");
+        return;
+    }
+    fprintf(file, "{\"restore_frame\":%llu,\"restored_frame\":%llu}\n",
+            (unsigned long long)snapshot_replayRestoreFrame,
+            (unsigned long long)debugger.frameCounter);
+    fclose(file);
+}
+
+static int
+snapshot_dumpStateToPath(const char *path)
+{
+    if (!path || !*path) {
+        return 0;
+    }
+    size_t stateSize = 0;
+    if (!libretro_host_getSerializeSize(&stateSize) || stateSize == 0) {
+        debug_error("snapshot: cannot determine restored replay state size");
+        return 0;
+    }
+    uint8_t *state = (uint8_t*)malloc(stateSize);
+    if (!state) {
+        debug_error("snapshot: cannot allocate restored replay state dump");
+        return 0;
+    }
+    if (!libretro_host_serializeTo(state, stateSize)) {
+        free(state);
+        debug_error("snapshot: cannot serialize restored replay state");
+        return 0;
+    }
+    FILE *file = fopen(path, "wb");
+    if (!file || fwrite(state, 1, stateSize, file) != stateSize) {
+        if (file) {
+            fclose(file);
+        }
+        free(state);
+        debug_error("snapshot: cannot write restored replay state dump");
+        return 0;
+    }
+    fclose(file);
+    free(state);
+    return 1;
+}
+
+void
+snapshot_dumpReplayState(void)
+{
+    const char *path = getenv("E9K_REPLAY_STATE_DUMP");
+    if (snapshot_dumpStateToPath(path)) {
+        size_t stateSize = 0;
+        libretro_host_getSerializeSize(&stateSize);
+        debug_printf("snapshot: wrote restored replay state dump bytes=%zu", stateSize);
+    }
+}
+
+void
+snapshot_dumpReplayFrameStateIfRequested(void)
+{
+    if (!snapshot_replayFrameDumpConfigured) {
+        const char *frameText = getenv("E9K_REPLAY_FRAME_DUMP_FRAME");
+        const char *path = getenv("E9K_REPLAY_FRAME_DUMP");
+        snapshot_replayFrameDumpConfigured = 1;
+        if (!frameText || !*frameText || !path || !*path) {
+            return;
+        }
+        char *end = NULL;
+        unsigned long long frame = strtoull(frameText, &end, 10);
+        if (!end || *end) {
+            debug_error("snapshot: invalid E9K_REPLAY_FRAME_DUMP_FRAME");
+            return;
+        }
+        if (strlen(path) >= sizeof(snapshot_replayFrameDumpPath)) {
+            debug_error("snapshot: E9K_REPLAY_FRAME_DUMP path is too long");
+            return;
+        }
+        snapshot_replayFrameDumpFrame = (uint64_t)frame;
+        strcpy(snapshot_replayFrameDumpPath, path);
+    }
+    if (snapshot_replayFrameDumped || !snapshot_replayFrameDumpPath[0] ||
+        debugger.frameCounter != snapshot_replayFrameDumpFrame) {
+        return;
+    }
+    snapshot_replayFrameDumped = 1;
+    if (snapshot_dumpStateToPath(snapshot_replayFrameDumpPath)) {
+        debug_printf("snapshot: wrote replay frame state frame=%llu",
+                     (unsigned long long)debugger.frameCounter);
+    }
+}
+
@@ -206,0 +290,5 @@ snapshot_loadSnapshotOnBoot(void)
+        if (snapshot_configureReplayRestore()) {
+            snapshot_replayRestorePending = 1;
+            debug_printf("snapshot: boot restore queued at frame=%llu",
+                         (unsigned long long)snapshot_replayRestoreFrame);
+        }
@@ -210,0 +299,33 @@ snapshot_loadSnapshotOnBoot(void)
+int
+snapshot_replayRestoreIsPending(void)
+{
+    return snapshot_replayRestorePending;
+}
+
+int
+snapshot_restoreReplayAtRuntime(void)
+{
+    if (!snapshot_replayRestorePending ||
+        debugger.frameCounter < snapshot_replayRestoreFrame) {
+        return 0;
+    }
+    snapshot_replayRestorePending = 0;
+    size_t restoredSize = 0;
+    if (!libretro_host_restoreState(&restoredSize)) {
+        debug_error("snapshot: failed to restore queued replay boot state");
+        return 1;
+    }
+    libretro_host_resetInputState();
+    snapshot_dumpReplayState();
+    if (!state_buffer_restoreSnapshot()) {
+        debug_error("snapshot: failed to restore queued replay state history");
+        return 1;
+    }
+    debugger.frameCounter = state_buffer_getCurrentFrameNo();
+    debugger.hasStateSnapshot = 1;
+    debug_printf("snapshot: restored replay boot state frame=%llu size=%zu",
+                 (unsigned long long)debugger.frameCounter, restoredSize);
+    snapshot_writeReplayRestoreMarker();
+    return 1;
+}
+
