diff --git a/e9k-debugger/runtime.c b/e9k-debugger/runtime.c
index 2c50665..485a2d5 100644
--- a/e9k-debugger/runtime.c
+++ b/e9k-debugger/runtime.c
@@ -30,0 +31 @@
+#include "snapshot.h"
@@ -81,0 +83 @@ runtime_onVblank(void *user)
+    snapshot_dumpReplayFrameStateIfRequested();
@@ -185,0 +187,10 @@ runtime_executeNextFrame(void)
+    // A human capture restores from the visible runtime loop.  Advance through
+    // its setup frames without replaying flight input, then restore before the
+    // next scheduled input frame.
+    if (snapshot_replayRestoreIsPending()) {
+        if (snapshot_restoreReplayAtRuntime()) {
+            return;
+        }
+        runtime_executeFrame(DEBUGGER_RUNMODE_CAPTURE, 0);
+        return;
+    }
@@ -324,2 +335,9 @@ runtime_runLoop(void)
-                                input_record_applyFrame(debugger.frameCounter + 1);
-                                runtime_executeFrame(DEBUGGER_RUNMODE_CAPTURE, 0);
+                                // A replay restore is queued against the host frame clock.
+                                // Do not bypass it while running accelerated smoke captures:
+                                // doing so advances a cold boot with recorded flight inputs.
+                                if (snapshot_replayRestoreIsPending()) {
+                                    runtime_executeNextFrame();
+                                } else {
+                                    input_record_applyFrame(debugger.frameCounter + 1);
+                                    runtime_executeFrame(DEBUGGER_RUNMODE_CAPTURE, 0);
+                                }
